# Copy to ".env" and fill in your real key. NEVER commit or zip ".env".
# --- Model configuration (non-secret values are real defaults) ---
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
# --- Secret ---
API_KEY=your-api-key-here
# Alternative names also understood by the code (use either set, not required):
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite
